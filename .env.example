# ==========================================
# Google Gemini API Key (Required for real LLM interview & evaluation)
# Get a key at: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model overrides
AI_INTERVIEWER_MODEL=gemini-2.5-flash
AI_EVALUATOR_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (if switching provider to OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# Supabase Authentication (Client-side)
# Get credentials at: https://supabase.com/dashboard/project/_/settings/api
# ==========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
